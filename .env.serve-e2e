# Nx loads this target-specific file before the development .env.
# Ports are deliberately NOT the development ones: e2e must never bind, or fall
# through to, a running `pnpm dev` stack and write its fixtures into the dev database.
NODE_ENV=test
DEMO_AUTH_ENABLED=true
DATABASE_URL=postgresql://opsflow:opsflow@localhost:5432/opsflow_e2e
API_PORT=3200
WORKER_PORT=3202
# Development workers sit on Redis database 0. Keep the test jobs off it.
REDIS_URL=redis://localhost:6379/1
# The browser suite runs its own sink on 18081; chaos scenarios use the WireMock
# container, which serves the stubs that really fail and really stall.
WEBHOOK_ALLOWED_ORIGINS=http://127.0.0.1:18081,http://localhost:8081
# Chaos scenarios fire here; must be an origin the worker already allows.
CHAOS_WEBHOOK_ORIGIN=http://localhost:8081
ORCHESTRATOR_PORT=3201
ORCHESTRATOR_GRPC_HOST=127.0.0.1
ORCHESTRATOR_GRPC_PORT=50052
ORCHESTRATOR_GRPC_URL=127.0.0.1:50052
ORCHESTRATOR_RPC_TIMEOUT_MS=2000
# The browser suite receives real OTLP traces alongside its webhook sink.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:18082/v1/traces
RUNTIME_SHARED_SECRET=cdf7ae655fb6fd0ad013c2d4b18b050ec4de32a03aca3a35
