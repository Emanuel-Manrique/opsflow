{
  "name": "@opsflow/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "nx run-many -t serve -p web-angular,api,orchestrator,worker",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && pnpm infra:up && pnpm db:migrate && pnpm db:seed",
    "db:migrate": "tsx --tsconfig libs/persistence/tsconfig.lib.json ./node_modules/typeorm/cli.js -d libs/persistence/src/data-source.ts migration:run",
    "db:revert": "tsx --tsconfig libs/persistence/tsconfig.lib.json ./node_modules/typeorm/cli.js -d libs/persistence/src/data-source.ts migration:revert",
    "db:show": "tsx --tsconfig libs/persistence/tsconfig.lib.json ./node_modules/typeorm/cli.js -d libs/persistence/src/data-source.ts migration:show",
    "db:seed": "tsx --tsconfig libs/persistence/tsconfig.lib.json libs/persistence/src/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:migration:create": "typeorm migration:create",
    "lint": "nx run-many -t lint",
    "boundaries": "nx run-many -t boundaries",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "integration": "nx run persistence:integration",
    "build": "nx run-many -t build",
    "e2e": "nx run-many -t e2e",
    "check": "nx run-many -t lint boundaries typecheck test build",
    "graph": "nx graph",
    "prepare": "is-ci || husky",
    "verify": "pnpm check && pnpm integration && pnpm e2e",
    "db:reset": "tsx --tsconfig libs/persistence/tsconfig.lib.json libs/persistence/src/reset.ts"
  },
  "dependencies": {
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "bullmq": "^6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron-parser": "^5.10.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "~7.8.0",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.6.0",
    "@analogjs/vitest-angular": "~2.6.0",
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@nx/angular": "23.2.0",
    "@nx/devkit": "23.2.0",
    "@nx/eslint": "^23.2.0",
    "@nx/eslint-plugin": "^23.2.0",
    "@nx/js": "23.2.0",
    "@nx/nest": "23.2.0",
    "@nx/node": "23.2.0",
    "@nx/oxlint": "23.2.0",
    "@nx/playwright": "23.2.0",
    "@nx/vite": "23.2.0",
    "@nx/vitest": "23.2.0",
    "@nx/web": "23.2.0",
    "@nx/webpack": "23.2.0",
    "@nx/workspace": "23.2.0",
    "@playwright/test": "^1.37.0",
    "@schematics/angular": "~22.1.0",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "~4.1.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "jsdom": "^27.1.0",
    "nx": "23.2.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.8",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  }
}
