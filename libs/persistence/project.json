{
  "name": "persistence",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/persistence/src",
  "projectType": "library",
  "tags": [
    "type:persistence",
    "scope:server"
  ],
  "// targets": "to see all targets run: nx show project persistence --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/persistence",
        "commands": [
          "tsc -p tsconfig.lib.json --noEmit",
          "tsc -p tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "integration": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "libs/persistence",
        "command": "vitest run --config vitest.integration.config.mts"
      }
    }
  }
}
