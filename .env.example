NODE_ENV=development
DEMO_AUTH_ENABLED=true
API_PORT=3100
ORCHESTRATOR_PORT=3101
WORKER_PORT=3102
DATABASE_URL=postgresql://opsflow:opsflow@localhost:5432/opsflow
DATABASE_POOL_MAX=10
DATABASE_LOGGING=false
POSTGRES_PORT=5432
REDIS_PORT=6379
WEBHOOK_SINK_PORT=8081
REDIS_URL=redis://localhost:6379
# Internal gRPC control plane; keep the listener on a trusted private interface.
ORCHESTRATOR_GRPC_HOST=127.0.0.1
ORCHESTRATOR_GRPC_PORT=50051
ORCHESTRATOR_GRPC_URL=127.0.0.1:50051
ORCHESTRATOR_RPC_TIMEOUT_MS=2000
WEBHOOK_SINK_URL=http://localhost:8081
# Comma-separated trusted origins (scheme + host + port). Empty denies webhooks.
WEBHOOK_ALLOWED_ORIGINS=http://localhost:8081
# Chaos scenarios fire here; must be an origin the worker already allows.
CHAOS_WEBHOOK_ORIGIN=http://localhost:8081
# Optional OTLP/HTTP JSON trace export. Logs and trace IDs work without a collector.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Shared by the API and the orchestrator on the internal gRPC surface. Rotate per
# environment; both services refuse to boot without it.
RUNTIME_SHARED_SECRET=5dcb821c45df4172af4b5583a4dc40b9cdc480c99ea5993d
# Optional. Unset keeps every finished run, its events and the audit log forever.
# Set it to a number of days and the orchestrator purges past it, once an hour.
# RETENTION_DAYS=14
